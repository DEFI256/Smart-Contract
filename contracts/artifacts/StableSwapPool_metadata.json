					}
				]
			},
			"kind": "dev",
			"methods": {
				"addLiquidity(uint256,uint256,uint256)": {
					"details": "添加流动性 添加A和B两种稳定币到流动性池，包含滑点保护"
				},
				"emergencyWithdraw(address,uint256)": {
					"details": "添加应急提款功能 - 仅限管理员"
				},
				"getD(uint256,uint256)": {
					"details": "Curve稳定币池的不变量计算函数 D 解方程：A * n^n * sum(x_i) + D = A * D * n^n + D^(n+1) / (n^n * prod(x_i)) 对于两个代币，n = 2"
				},
				"getPairedAmount(uint256,bool)": {
					"details": "根据输入的代币数量计算对应的另一方代币数量以保持池子比例"
				},
				"getReservesAndLiquidity()": {
					"details": "获取池子的基本信息"
				},
				"getSwapDetails(uint256,bool)": {
					"details": "预先查询兑换数量  返回手续费、预估输出数量和价格影响"
				},
				"getYForX(uint256,uint256,uint256)": {
					"details": "计算稳定币交换的输出数量 基于Curve的稳定币交换公式"
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"pause()": {
					"details": "暂停合约"
				},
				"removeLiquidity(uint256,uint256,uint256)": {
					"details": "移除部分或全部流动性",
					"params": {
						"lpAmount": "要移除的LP代币数量，0表示全部移除",
						"minAmountA": "tokenA的最小返还量",
						"minAmountB": "tokenB的最小返还量"
					}
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"setAmplificationCoefficient(uint256)": {
					"details": "更新放大系数 仅限所有者调用"
				},
				"swap(uint256,bool,uint256)": {
					"details": "兑换稳定币，支持滑点保护"
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				},
				"unpause()": {
					"details": "恢复合约运行"
				}
			},
			"version": 1
		},
